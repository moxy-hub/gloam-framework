org.springframework.boot.autoconfigure.EnableAutoConfiguration=com.gloamframework.core.GloamCoreConfigure
org.springframework.boot.diagnostics.FailureAnalyzer=com.gloamframework.core.diagnostics.GloamStartExceptionDiagnostics
org.springframework.boot.env.EnvironmentPostProcessor=com.gloamframework.core.env.GloamEnvironmentProcessor
org.springframework.context.ApplicationListener=com.gloamframework.core.env.GloamEnvironmentProcessor

